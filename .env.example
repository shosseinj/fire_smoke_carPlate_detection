DATABASE_URL=postgresql+psycopg2://postgres:Asd12345@host.docker.internal:5432/ai_database
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
BUSINESS_TIMEZONE=Asia/Tehran

# Local Qdrant server. Manual app containers use Docker Desktop's host gateway.
# Docker Compose overrides this with http://qdrant:6333.
FACE_QDRANT_URL=http://host.docker.internal:6333
FACE_QDRANT_API_KEY=
FACE_QDRANT_COLLECTION=faces

# Change these before deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_DEFAULT_ADMIN_USERNAME=superadmin
AUTH_DEFAULT_ADMIN_PASSWORD=SuperAdmin123!

# Performance tuning - FPS and batch processing
# For cameras above 20 FPS, start at 25 FPS and use the bounded FPS diagnostic
# sampler before increasing further. Worker queues remain latest-frame bounded.
# - Set ingest FPS slightly above camera FPS to avoid frame drops
# - Use longer batch wait times to accumulate frames for efficient batch processing
VIDEO_INGEST_FPS=25
VIDEO_PREVIEW_FPS=10
GPU_RESIZE_ENABLED=true
BROADCAST_FACE_OVERLAY_TTL_MS=250
# Real-time CCTV default. Use lossless_fifo only for bounded file/API workloads.
TASK_QUEUE_POLICY=latest_per_source
TASK_QUEUE_CAPACITY=256
# 0 means wait for bounded FIFO capacity instead of rejecting a task submission.
TASK_QUEUE_BLOCK_TIMEOUT_MS=0
FIRE_SMOKE_MAX_WAIT_MS=50
FIRE_LOW_SEVERITY_CONFIDENCE=0.45
FIRE_MEDIUM_SEVERITY_CONFIDENCE=0.50
FIRE_HIGH_SEVERITY_CONFIDENCE=0.60
SMOKE_LOW_SEVERITY_CONFIDENCE=0.40
SMOKE_MEDIUM_SEVERITY_CONFIDENCE=0.45
SMOKE_HIGH_SEVERITY_CONFIDENCE=0.55
PLATE_MAX_WAIT_MS=50
PLATE_LOG_QUEUE_SIZE=128
FACE_MAX_WAIT_MS=50
WORKER_THREADS=1
SKIP_TASKLESS_SOURCES=true
