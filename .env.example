APP_NAME=Unified Video AI Task Router
PROCESSOR_MODE=real
SOURCE_REGISTRY_PATH=data/sources.json
RECENT_RESULTS_LIMIT=2000
MODEL_ROOT_PATH=weights
MODEL_PREFERRED_FORMAT=engine
MODEL_ALLOW_ONNX_FALLBACK=true
MODEL_ALLOW_PT_FALLBACK=true
MODEL_EXPORT_IMGSZ=640
MODEL_EXPORT_BATCH_SIZE=16
MODEL_EXPORT_WORKSPACE_GB=4
MODEL_EXPORT_HALF=true
MODEL_EXPORT_DYNAMIC=true
MODEL_EXPORT_TIMEOUT_SECONDS=300
VIDEO_INGESTION_ENABLED=true
VIDEO_INGEST_BACKEND=opencv
VIDEO_INGEST_FPS=5
VIDEO_PREVIEW_FPS=25
VIDEO_LOOP=true
RTSP_TRANSPORT=tcp
RTSP_INGESTION_ENABLED=true
RTSP_OPEN_TIMEOUT_MS=20000
RTSP_READ_TIMEOUT_MS=10000
RTSP_RECONNECT_SECONDS=3
DEEPSTREAM_RTSP_LATENCY_MS=500
DEEPSTREAM_RTSP_STALL_TIMEOUT_SECONDS=30
BROADCAST_ENABLED=true
BROADCAST_JPEG_QUALITY=82
PLATE_LOG_DB_PATH=data/plate_logs.sqlite3
SAVED_MEDIA_PATH=saved_media
FIRE_SEVERITY_WINDOW_SECONDS=3
FIRE_LOW_INCIDENT_COUNT=5
FIRE_MEDIUM_INCIDENT_COUNT=10
FIRE_HIGH_INCIDENT_COUNT=20

FIRE_SMOKE_MODEL_PATH=weights/fire_smoke/best_nano_11.pt
FIRE_SMOKE_DEVICE=0
FIRE_SMOKE_BATCH_SIZE=8
FIRE_SMOKE_MAX_WAIT_MS=25
FIRE_SMOKE_IMGSZ=640
FIRE_SMOKE_ENGINE_FIXED_BATCH=8
FIRE_CONFIDENCE=0.30
SMOKE_CONFIDENCE=0.30

PLATE_DETECTOR_WEIGHTS=weights/plate_detector/model.pt
PLATE_CLASS_IDS=0
VEHICLE_DETECTOR_WEIGHTS=weights/vehicle_detector/yolo11n.pt
PLATE_RECOGNIZER_DIR=weights/plate_recognizer
PLATE_DEVICE=0
PLATE_BATCH_SIZE=8
PLATE_MAX_WAIT_MS=25
PLATE_IMGSZ=640
PLATE_CONFIDENCE=0.30
PLATE_IOU=0.45
PLATE_CROP_BATCH_SIZE=16
VEHICLE_CONFIDENCE=0.35
VEHICLE_IOU=0.45
VEHICLE_IMGSZ=640
VEHICLE_MAX_PER_FRAME=12
VEHICLE_CLASS_IDS=2,3,5,7
VEHICLE_CROP_PADDING_RATIO=0.05
PLATE_OCR_CONFIDENCE=0.50
MIN_VEHICLE_WIDTH_PIXELS=120
MIN_VEHICLE_HEIGHT_PIXELS=80
MIN_VEHICLE_AREA_RATIO=0.025
PLATE_USE_FP16=true

# Face detectors currently use PT. The previous project has no ArcFace PT file,
# so embeddings use arcface_fp16.onnx through OpenCV DNN when ONNX Runtime is absent.
FACE_HUMAN_MODEL=weights/face_recognition/yolo26s-pose_batch8.pt
FACE_DETECTOR_MODEL=weights/face_recognition/yolov8n-face_batch8.pt
FACE_EMBEDDING_MODEL=weights/face_recognition/arcface_fp16.onnx
FACE_DEVICE=0
FACE_BATCH_SIZE=8
FACE_MAX_WAIT_MS=25
FACE_HUMAN_IMGSZ=640
FACE_DETECTOR_IMGSZ=640
FACE_HUMAN_ENGINE_FIXED_BATCH=8
FACE_DETECTOR_ENGINE_FIXED_BATCH=8
FACE_HUMAN_CONFIDENCE=0.40
FACE_DETECTION_CONFIDENCE=0.50
FACE_RECOGNITION_THRESHOLD=0.45
FACE_MIN_SIZE=24
FACE_BLUR_THRESHOLD=20
FACE_MIN_EYE_DISTANCE=8
FACE_QUALITY_THRESHOLD=0.55
FACE_MAX_ABS_YAW=45
FACE_MAX_ABS_PITCH=55
FACE_MAX_ABS_ROLL=35
FACE_REQUIRE_LANDMARKS=true
FACE_TRACKER_HIGH_THRESHOLD=0.40
FACE_TRACKER_LOW_THRESHOLD=0.10
FACE_TRACKER_NEW_THRESHOLD=0.40
FACE_TRACKER_MATCH_THRESHOLD=0.80
FACE_TRACKER_MAX_MISSED=30
FACE_HISTORY_SIZE=30
FACE_STABLE_MIN_HITS=3
FACE_EMBEDDING_BATCH_SIZE=64
FACE_VECTOR_SIZE=512
FACE_QDRANT_COLLECTION=faces
FACE_QDRANT_PATH=data/qdrant
# Set FACE_QDRANT_URL and FACE_QDRANT_API_KEY only when using a remote Qdrant server.

# Per-human evidence media is written asynchronously and never on the AI worker.
HUMAN_VIDEO_FPS=10
HUMAN_VIDEO_IDLE_SECONDS=5
HUMAN_SNAPSHOT_MIN_IMPROVEMENT=0.01
