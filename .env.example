DATABASE_URL=postgresql+psycopg2://postgres:Asd1234@host.docker.internal:5432/ai_database
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
BUSINESS_TIMEZONE=Asia/Tehran

# Optional remote vector database. Leave blank to store embeddings in PostgreSQL.
FACE_QDRANT_URL=
FACE_QDRANT_API_KEY=
FACE_QDRANT_COLLECTION=faces

# Change these before deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=replace-this-password
