FROM merged-video-ai-router:v8

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENV YOLO_CONFIG_DIR=/tmp
ENV MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /workspace

# Install only application-level system dependencies inside the image.
# Nothing is installed on Windows.


# COPY requirements.deepstream.txt /workspace/requirements.txt

# RUN python3 -m pip install \
#     --no-cache-dir \
#     -r /workspace/requirements.txt

# Required for explicit ONNX export and runtime fallback. TensorRT is supplied
# by the NVIDIA DeepStream base image.
# RUN python3 -m pip install --no-cache-dir \
#     --force-reinstall \
#     "tensorrt-cu12==10.3.0"

# RUN python3 -m pip install --no-cache-dir \
#     "onnx>=1.12.0,<2.0.0" \
#     "onnxruntime-gpu>=1.18.0,<2.0.0" \
#     "onnxslim>=0.1.71" \
#     "nvidia-modelopt[onnx]>=0.44"


# RUN python3 -m pip install --no-cache-dir --no-deps "onnx" "onnxruntime-gpu"
# COPY . /workspace

# RUN python3 -m pip install \
#     --no-deps \
#     torch==2.4.1 \
#     torchvision==0.19.1 \
#     torchaudio==2.4.1 \
