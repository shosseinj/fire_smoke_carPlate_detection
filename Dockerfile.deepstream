# RUN pip install --no-cache-dir --no-deps ultralytics
# RUN python3 -m pip install requests
# RUN python3 -m pip uninstall -y transformers

# RUN python3 -m pip install --no-cache-dir \
#     "transformers==4.51.3"

# ByteTrack uses LAP for its two-stage detection association.
# TensorRT is supplied by the DeepStream base image (10.3).
# RUN python3 -m pip install --no-cache-dir 'tensorrt-cu12==11.1.0.106' 
# RUN python3 -m pip install --no-cache-dir \
#     "onnx>=1.12.0,<2.0.0" \
#     onnxruntime-gpu \
#     "onnxslim>=0.1.82"


RUN python3 -m pip install --no-cache-dir   "tensorrt==10.7.0"
RUN mkdir -p \
    /workspace/data \
    /workspace/saved_media \
    /workspace/models

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
