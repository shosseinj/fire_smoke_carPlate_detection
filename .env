FACE_HUMAN_MODEL=/workspace/weights/face_recognition/linux_trt10/yolo26s-pose_dynamic_b8_trt107.engine
FACE_DETECTOR_MODEL=/workspace/weights/face_recognition/linux_trt10/yolov8n-face_dynamic_b8_trt107.engine
