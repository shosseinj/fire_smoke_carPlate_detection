DATABASE_URL=postgresql+psycopg2://postgres:Asd12345@host.docker.internal:5432/ai_database
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
BUSINESS_TIMEZONE=Asia/Tehran
FACE_QDRANT_URL=http://host.docker.internal:6333
FACE_QDRANT_COLLECTION=faces

# Change these in production.
JWT_SECRET_KEY=replace-with-a-long-random-secret
AUTH_DEFAULT_ADMIN_USERNAME=superadmin
AUTH_DEFAULT_ADMIN_PASSWORD=SuperAdmin123!
DISABLE_AUTH=false

# Performance tuning - FPS and batch processing
# For 8 cameras at 5 FPS each (40 total FPS):
# - Set sources.fps only when a per-source override is required
# - Use longer batch wait times to accumulate frames for efficient batch processing
FIRE_SMOKE_MAX_WAIT_MS=50
PLATE_MAX_WAIT_MS=50
FACE_MAX_WAIT_MS=50
WORKER_THREADS=1
SKIP_TASKLESS_SOURCES=false

DETECTION_EVENTS_ENABLED=true
HUMAN_EVENT_MEDIA_ENABLED=true
HUMAN_EVENT_MEDIA_WRITE_ENABLED=true
HUMAN_EVENT_CLIP_PADDING_SECONDS=5
LEGACY_DETECTION_PERSISTENCE_ENABLED=false

RECORDING_REDIS_URL=redis://redis:6379/0
LIVE_BRANCH_ENABLED=true
LIVE_RECORDING_SEGMENT_SECONDS=120
CONTINUOUS_RECORDING_TEMP_PATH=/workspace/saved_media/temporary_minIO/continuous
HUMAN_EVENT_MEDIA_TEMP_PATH=/workspace/saved_media/temporary_minIO/human_track
CONTINUOUS_RECORDING_LOCAL_PATH=/workspace/saved_media/continuous
HUMAN_EVENT_MEDIA_LOCAL_PATH=/workspace/saved_media/human_track

RECORDING_MINIO_ENDPOINT=minio:9000
RECORDING_MINIO_BUCKET=recordings
RECORDING_MINIO_ACCESS_KEY=your-access-key
RECORDING_MINIO_SECRET_KEY=your-secret-key
