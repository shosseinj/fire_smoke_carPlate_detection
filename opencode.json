{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "live-branch-orchestrator",

  "instructions": ["AGENTS.md", ".opencode/instructions/*.md"],

  "permission": {
    "*": "ask",

    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",

    "edit": "ask",

    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",

      "git add*": "ask",
      "git commit*": "ask",

      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",

      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "docker compose config*": "allow",
      "docker ps*": "allow",
      "docker inspect*": "allow",

      "docker compose up*": "ask",
      "docker compose down*": "ask",
      "docker compose build*": "ask",
      "docker compose exec*": "ask",
      "docker compose run*": "ask",

      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python -m compileall*": "allow",
      "python scripts/*": "allow",

      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run build*": "allow",
      "npx playwright test*": "allow",

      "powershell*": "ask",
      "pwsh*": "ask"
    },

    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask"
  },

  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },

  "share": "disabled"
}
